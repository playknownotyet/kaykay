#!/usr/bin/env python
# Apple Music eklentisi (yalnız iOS, MediaPlayer). GitHub'ın Mac'inde derlenir
# (.github/workflows/ios-testflight.yml):
#   scons platform=ios arch=arm64 target=template_release
# godot-cpp bu klasöre iş akışında indirilir (depoya girmez). Çıktı: bin/libapple_muzik.ios.<target>.a
env = SConscript("godot-cpp/SConstruct")

lib_env = env.Clone()
lib_env.Append(CPPPATH=["src/"])
# Objective-C++ (ARC). MediaPlayer çerçevesini kaynak kendisi ister (.linker_option, apple_muzik.mm)
lib_env.Append(CCFLAGS=["-fobjc-arc"])
sources = Glob("src/*.mm")
library = lib_env.StaticLibrary("bin/libapple_muzik.{}.{}.a".format(env["platform"], env["target"]), source=sources)
Default(library)
