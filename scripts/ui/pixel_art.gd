## Yazının piksel genişliği (ölçek s ile)
static func text_width(text: String, s: float) -> float:
	return maxf(text.length() * 6.0 - 1.0, 0.0) * s


## Piksel yazı: sol üst köşe pos, piksel boyu s. outline > 0 ise koyu kenar
static func draw_text(ci: CanvasItem, text: String, pos: Vector2, s: float, color: Color, outline := Color(0, 0, 0, 0)) -> void:
	text = text.to_upper()
	if outline.a > 0.0:
		for o in [Vector2(-1, 0), Vector2(1, 0), Vector2(0, -1), Vector2(0, 1), Vector2(1, 1)]:
			_text(ci, text, pos + o * s, s, outline)
	_text(ci, text, pos, s, color)


static func _text(ci: CanvasItem, text: String, pos: Vector2, s: float, color: Color) -> void:
	var x := pos.x
	for ch in text:
		var g: Array = FONT.get(ch, FONT[" "])
		for r in g.size():
			var row: String = g[r]
			for c in row.length():
				if row[c] == "#":
					ci.draw_rect(Rect2(x + c * s, pos.y + r * s, s + 0.5, s + 0.5), color)
		x += 6.0 * s


## Piksel ikon, merkezde; boy: ikonun toplam genişliği (piksel)
static func draw_icon(ci: CanvasItem, name: String, center: Vector2, size: float, color: Color) -> void:
	var g: Array = ICONS.get(name, [])
	if g.is_empty():
		return
	var n: int = g.size()
	var s := floorf(size / n)
	var origin := center - Vector2(n, n) * s * 0.5
	for r in n:
		var row: String = g[r]
		for c in row.length():
			if row[c] == "#":
				ci.draw_rect(Rect2(origin.x + c * s, origin.y + r * s, s, s), color)


## Retro buton: köşeleri basamaklı koyu kutu, açık çerçeve, ortada ikon
static func draw_button(ci: CanvasItem, rect: Rect2, icon: String, pressed: bool, accent := Color(1.0, 0.82, 0.25)) -> void:
	var px := maxf(floorf(rect.size.x / 22.0), 2.0)
	var bg := Color(0.08, 0.09, 0.12, 0.72) if not pressed else Color(accent.r * 0.55, accent.g * 0.55, accent.b * 0.4, 0.9)
	var edge := Color(1, 1, 1, 0.85) if not pressed else accent
	_stepped_rect(ci, rect, px, edge)
	_stepped_rect(ci, rect.grow(-px), px, bg)
	# Alt gölge: basılı değilken buton "kalkık" dursun
	if not pressed:
		ci.draw_rect(Rect2(rect.position.x + px * 2, rect.end.y - px * 2, rect.size.x - px * 4, px), Color(0, 0, 0, 0.35))
	draw_icon(ci, icon, rect.get_center() + Vector2(0, px * (0.5 if pressed else 0.0)), rect.size.x * 0.56, edge if pressed else Color(1, 1, 1, 0.95))


## Yuvarlak retro buton (piksel kenarlı daire): yaya zıplama / binme
static func draw_round_button(ci: CanvasItem, rect: Rect2, icon: String, pressed: bool, accent := Color(1.0, 0.82, 0.25), icon_color := Color(1, 1, 1, 0.95)) -> void:
	var c := rect.get_center()
	var rad := rect.size.x * 0.5
	var px := maxf(floorf(rect.size.x / 22.0), 2.0)
	var bg := Color(0.08, 0.09, 0.12, 0.62) if not pressed else Color(accent.r * 0.55, accent.g * 0.55, accent.b * 0.4, 0.85)
	var edge := Color(1, 1, 1, 0.8) if not pressed else accent
	_pixel_disc(ci, c, rad, px, edge)
	_pixel_disc(ci, c, rad - px, px, bg)
	draw_icon(ci, icon, c + Vector2(0, px * (0.5 if pressed else 0.0)), rect.size.x * 0.46, edge if pressed else icon_color)


## Piksel ızgarasına oturan dolu daire (yatay şeritler)
static func _pixel_disc(ci: CanvasItem, c: Vector2, rad: float, px: float, color: Color) -> void:
	var n := int(ceilf(rad / px))
	for i in range(-n, n):
		var y := (i + 0.5) * px
		var hw := floorf(sqrt(maxf(rad * rad - y * y, 0.0)) / px) * px
		if hw > 0.0:
			ci.draw_rect(Rect2(c.x - hw, c.y + i * px, hw * 2.0, px), color)


static func _stepped_rect(ci: CanvasItem, r: Rect2, px: float, color: Color) -> void:
	ci.draw_rect(Rect2(r.position.x + px, r.position.y, r.size.x - px * 2, r.size.y), color)
	ci.draw_rect(Rect2(r.position.x, r.position.y + px, r.size.x, r.size.y - px * 2), color)
